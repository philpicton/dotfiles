{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash"
    ],
    "deny": [
      "Read(//**/.env)",
      "Edit(//**/.env)"
    ],
    "ask": [
      "Bash(npm *)",
      "Bash(rm *)",
      "Bash(sudo *)"
    ],
    "additionalDirectories": [
      "/Users/phil/code",
      "/Users/phil/.dotfiles",
      "/Users/phil/Desktop"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/git-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/env-guard.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "haya@phil-local": true,
    "chrome-devtools@phil-local": true,
    "nuxt@phil-local": true,
    "sentry@phil-local": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "phil-local": {
      "source": {
        "source": "directory",
        "path": "/Users/phil/.claude/local-marketplace"
      }
    }
  },
  "theme": "custom:phil",
  "switchModelsOnFlag": false
}
