{
  "$schema": "https://opencode.ai/config.json",
  // Code formatting
  "formatter": true,
  // LSP (Language Server Protocol) support
  "lsp": true,
  // ignore busy directories for file watcher
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".nuxt/**",
      "vendor/**",
    ],
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000,
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
    },
    "nuxt": {
      "type": "remote",
      "url": "https://nuxt.com/mcp",
      "enabled": true,
    },
  },

  "permission": {
    "external_directory": {
      "~/code/**": "allow",
      "~/.dotfiles/**": "allow",
      "~/Desktop/**": "allow",
    },

    "bash": {
      "*": "allow",

      // Read-only Git
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git describe *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git cat-file *": "allow",
      "git shortlog *": "allow",

      "git branch *": "deny",
      "git branch": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch --all": "allow",
      "git branch --show-current": "allow",

      "git tag *": "deny",
      "git tag": "allow",
      "git tag -l": "allow",
      "git tag --list": "allow",

      "git remote *": "deny",
      "git remote -v": "allow",
      "git remote get-url *": "allow",

      // Git mutations
      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git pull *": "deny",
      "git checkout *": "deny",
      "git switch *": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git revert *": "deny",
      "git stash *": "deny",
      "git fetch *": "deny",
      "git clone *": "deny",
      "git clean *": "deny",
      "git rm *": "deny",
      "git mv *": "deny",
      "git cherry-pick *": "deny",
      "git bisect *": "deny",
      "git worktree *": "deny",
      "git submodule *": "deny",
      "git filter-branch *": "deny",
      "git gc *": "deny",
      "git prune *": "deny",
      "git reflog delete *": "deny",
      "git reflog expire *": "deny",
      "git replace *": "deny",
      "git notes *": "deny",

      // Other shell commands
      "npm *": "ask",
      "rm *": "ask",
      "docker *": "allow",
      "sudo *": "ask",
      "make *": "allow",
    },
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "qwen65k:latest": {
          "name": "qwen65k:latest",
        },
        "qwen128k:latest": {
          "name": "qwen128k:latest",
        },
      },
    },
  },
}
