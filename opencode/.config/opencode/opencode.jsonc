{
  "$schema": "https://opencode.ai/config.json",
  // Code formatting
  "formatter": true,
  // LSP (Language Server Protocol) support
  "lsp": true,
  // ignore busy directories for file watcher
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".nuxt/**",
      "vendor/**",
    ],
  },
  "compaction": {
    "auto": true,
    // tokens kept free before auto-compaction kicks in (v1: "reserved")
    "buffer": 10000,
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true,
      },
      "nuxt": {
        "type": "remote",
        "url": "https://nuxt.com/mcp",
        "disabled": true,
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp/haysto",
        "oauth": {},
        "disabled": true,
      },
    },
  },

  // Ordered rules, evaluated in the same order as the v1 "permission" map
  "permissions": [
    { "action": "external_directory", "resource": "~/code/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.dotfiles/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Desktop/**", "effect": "allow" },

    { "action": "shell", "resource": "*", "effect": "allow" },

    // Read-only Git
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git describe *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git cat-file *", "effect": "allow" },
    { "action": "shell", "resource": "git shortlog *", "effect": "allow" },

    { "action": "shell", "resource": "git branch *", "effect": "deny" },
    { "action": "shell", "resource": "git branch", "effect": "allow" },
    { "action": "shell", "resource": "git branch -a", "effect": "allow" },
    { "action": "shell", "resource": "git branch -r", "effect": "allow" },
    { "action": "shell", "resource": "git branch --all", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },

    { "action": "shell", "resource": "git tag *", "effect": "deny" },
    { "action": "shell", "resource": "git tag", "effect": "allow" },
    { "action": "shell", "resource": "git tag -l", "effect": "allow" },
    { "action": "shell", "resource": "git tag --list", "effect": "allow" },

    { "action": "shell", "resource": "git remote *", "effect": "deny" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "git remote get-url *", "effect": "allow" },

    // Git mutations
    { "action": "shell", "resource": "git add *", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git pull *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout *", "effect": "deny" },
    { "action": "shell", "resource": "git switch *", "effect": "deny" },
    { "action": "shell", "resource": "git merge *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git revert *", "effect": "deny" },
    { "action": "shell", "resource": "git stash *", "effect": "deny" },
    { "action": "shell", "resource": "git fetch *", "effect": "deny" },
    { "action": "shell", "resource": "git clone *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git rm *", "effect": "deny" },
    { "action": "shell", "resource": "git mv *", "effect": "deny" },
    { "action": "shell", "resource": "git cherry-pick *", "effect": "deny" },
    { "action": "shell", "resource": "git bisect *", "effect": "deny" },
    { "action": "shell", "resource": "git worktree *", "effect": "deny" },
    { "action": "shell", "resource": "git submodule *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "deny" },
    { "action": "shell", "resource": "git gc *", "effect": "deny" },
    { "action": "shell", "resource": "git prune *", "effect": "deny" },
    { "action": "shell", "resource": "git reflog delete *", "effect": "deny" },
    { "action": "shell", "resource": "git reflog expire *", "effect": "deny" },
    { "action": "shell", "resource": "git replace *", "effect": "deny" },
    { "action": "shell", "resource": "git notes *", "effect": "deny" },

    // Other shell commands
    { "action": "shell", "resource": "npm *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker *", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "make *", "effect": "allow" },
  ],

  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "qwen65k:latest": {
          "name": "qwen65k:latest",
        },
        "qwen128k:latest": {
          "name": "qwen128k:latest",
        },
      },
    },
  },
}
